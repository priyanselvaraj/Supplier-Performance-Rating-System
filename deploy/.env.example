# ==============================================================================
# Supplier Performance Rating System (SPRS)
# Production Environment Variable Configuration Template
# ==============================================================================

# Node / Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=supplier_rating_db
DB_USERNAME=spruser
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
DB_ROOT_PASSWORD=YOUR_SECURE_ROOT_PASSWORD_HERE

# Security & JWT Authentication
# JWT Secret MUST be at least 256 bits (32+ bytes hex/base64 encoded)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated URLs)
ALLOWED_ORIGINS=https://sprs.example.com,http://localhost:80,http://localhost

# Port Bindings
BACKEND_PORT=8080
FRONTEND_PORT=80
DB_PORT=3306

# Backup Configuration
BACKUP_DIR=/backups
RETENTION_DAYS=30
