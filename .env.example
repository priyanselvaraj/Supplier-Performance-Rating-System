# ==========================================
# Supplier Performance Rating System (SPRS)
# Environment Configuration Template
# ==========================================

# Backend Server Configuration
BACKEND_PORT=8080
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=supplier_rating_db
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=rootpassword

# Gmail SMTP (use a Gmail App Password, never your normal Gmail password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM=yourgmail@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# JWT Security Secrets (Must be at least 256-bit / 32+ characters hex/base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173

# Frontend Web Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
